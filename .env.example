# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="file://{pwd}/prisma/talentlens.db"

# Secret used to sign JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-secret"

# Access token lifetime in seconds (default: 3600)
JWT_TTL_SECONDS=3600

# Comma-separated list of origins allowed to make credentialed
# requests (cookies). Cannot be "*" when credentials are enabled.
# Defaults to http://localhost:5173
CORS_ORIGINS=http://localhost:5173