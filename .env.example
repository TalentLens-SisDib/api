# SQLite database, relative to the API working directory.
DATABASE_URL="file:./prisma/talentlens.db"
PORT=3000

# Secret used to sign JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-secret"

# Access token lifetime in seconds (default: 3600)
JWT_TTL_SECONDS=3600

# Comma-separated list of origins allowed to make credentialed
# requests (cookies). Cannot be "*" when credentials are enabled.
# Defaults to http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Protocol: openrouter, openai (compatible servers), anthropic or gemini.
AI_PROVIDER=openrouter
# Automatically select from the available free models on OpenRouter.
# A specific vendor/model:free is also accepted; paid models are rejected.
AI_MODEL=openrouter/free
# Server-side only. May be empty for local OpenAI-compatible servers.
AI_API_KEY=
# Base URL including the API version, without the operation path.
AI_API_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_MS=60000
